# Complete template for the Docker dev stack (docker-compose.yml).
# cp .env.docker.example .env && docker compose exec app php artisan key:generate
APP_NAME="Photo Portfolio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://photo.local:8081
TMPDIR=/var/www/html/storage/tmp

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL 8.4 in the `db` service (values also read by docker-compose.yml)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=photo
DB_USERNAME=photo
DB_PASSWORD=photo
MYSQL_DATABASE=photo
MYSQL_USER=photo
MYSQL_PASSWORD=photo
MYSQL_ROOT_PASSWORD=root

# Host ports
WEB_PORT=8081
DB_PORT_HOST=3307
MAILPIT_PORT=8026

SESSION_DRIVER=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# CRITICAL: Filament notifications are ShouldQueue - without a worker nothing is sent.
QUEUE_CONNECTION=sync

# Mailpit (UI: http://localhost:8026)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="noreply@photo.local"
MAIL_FROM_NAME="${APP_NAME}"

# Media pipeline (see app/Support/PhotoMedia.php)
MEDIA_DISK=public
MEDIA_DRIVER=gd
MEDIA_LARGE_MAX=2560
MEDIA_MEDIUM_MAX=1600
MEDIA_THUMB_SIZE=600
